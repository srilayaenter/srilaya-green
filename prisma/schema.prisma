datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Admin-only accounts (role = "admin" | "owner").
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

// Customer accounts — optional; guests can still check out without registering.
// Account + Session mirror the naturals.com schema so credentials can be shared
// across all SriLaYa sites when the unified auth layer is implemented (issue #34).
model Account {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  name              String?
  phone             String?
  emailVerified     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sessions          Session[]
}

model Session {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([token])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  products    Product[]
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String?
  imageUrl    String?
  currency    String           @default("INR")
  gstRate     Decimal          @db.Decimal(4, 2)
  sku         String           @unique
  active      Boolean          @default(true)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]
  reviews     Review[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  email      String
  rating     Int
  title      String?
  body       String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size        String
  price       Decimal     @db.Decimal(10, 2)
  stock       Int         @default(100)
  weightGrams Int         @default(500)
  sku         String      @unique
  imageUrl    String?
  active      Boolean     @default(true)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([productId, size])
}

model Cart {
  id        String     @id @default(cuid())
  email     String?
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  price     Decimal        @db.Decimal(10, 2)
  gstRate   Decimal        @db.Decimal(4, 2)

  @@unique([cartId, variantId])
}

model Order {
  id                String      @id @default(cuid())
  items             OrderItem[]
  shipment          Shipment?
  subtotal          Decimal     @db.Decimal(10, 2)
  taxTotal          Decimal     @db.Decimal(10, 2)
  shippingFee       Decimal     @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  currency          String      @default("INR")
  status            String      @default("pending") // pending | cod_pending | paid | processing | shipped | delivered | cancelled
  fulfillmentStatus String      @default("pending")
  paymentMethod     String? // cod | razorpay
  paymentId         String?
  codPaymentMethod  String? // "cash" | "upi" — recorded when COD is collected
  codUpiRef         String? // UPI transaction ref / UTR (optional)
  couponCode        String?
  discountAmount    Decimal?  @db.Decimal(10, 2)

  customerName String?
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?

  returns   Return[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Decimal        @db.Decimal(10, 2)
  gstRate   Decimal        @db.Decimal(4, 2)
}

model Shipment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier           String
  trackingNumber    String
  trackingUrl       String?
  status            String    @default("booked")
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @unique
  processedAt DateTime @default(now())
}

model Return {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason    String
  status    String       @default("requested") // requested | approved | rejected | received | refunded
  adminNote String?
  items     ReturnItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ReturnItem {
  id        String @id @default(cuid())
  returnId  String
  return    Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variantId String
  title     String
  size      String
  quantity  Int
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    // "percent" | "fixed"
  value       Decimal   @db.Decimal(10, 2)
  minOrder    Decimal?  @db.Decimal(10, 2)
  maxUses     Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model FailedEmail {
  id           String    @id @default(cuid())
  to           String
  subject      String
  html         String
  context      String?
  errorMessage String
  retriedAt    DateTime?
  resolved     Boolean   @default(false)
  createdAt    DateTime  @default(now())
}
