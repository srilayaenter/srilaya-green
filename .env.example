# Supabase PostgreSQL — create a project at https://supabase.com and copy these from
# Project Settings > Database. Use the pooled connection string for DATABASE_URL and
# the direct connection string for DIRECT_URL (used only for migrations).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay — https://dashboard.razorpay.com/app/keys (use test keys during development)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET=""

# Resend — https://resend.com/api-keys (emails are skipped with a console log if absent)
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
ADMIN_ALERT_EMAIL=""

# Seed script admin account (used by `npm run seed`)
SEED_ADMIN_EMAIL="admin@srilaya-green.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional
BRAND_GSTIN=""

# Authorizes /api/cron/release-stale-pending-orders (releases stock reserved
# by abandoned Razorpay-pending orders older than 30 minutes). Must also be
# set as an environment variable on Vercel, and scheduled via vercel.json's
# crons entry, which sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
